/* ── Reset ─────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:          #07080f;
  --bg2:         #0d0f1c;
  --bg3:         #12152a;
  --glass:       rgba(18,21,42,0.7);
  --border:      rgba(255,255,255,0.07);
  --border2:     rgba(255,255,255,0.13);
  --cyan:        #00e5ff;
  --cyan-dim:    rgba(0,229,255,0.1);
  --green:       #00e676;
  --green-dim:   rgba(0,230,118,0.1);
  --purple:      #c084fc;
  --purple-dim:  rgba(192,132,252,0.1);
  --orange:      #fb923c;
  --orange-dim:  rgba(251,146,60,0.1);
  --blue:        #60a5fa;
  --blue-dim:    rgba(96,165,250,0.1);
  --red:         #f87171;
  --red-dim:     rgba(248,113,113,0.1);
  --text:        #e2e8f0;
  --muted:       #64748b;
  --muted2:      #94a3b8;
  --radius:      16px;
  --radius-sm:   10px;
  --shadow:      0 20px 60px rgba(0,0,0,0.5);
  --t:           all 0.2s cubic-bezier(0.4,0,0.2,1);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: var(--bg);
  background-image:
    radial-gradient(ellipse 80% 50% at 20% -10%, rgba(0,80,160,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 110%, rgba(100,0,180,0.08) 0%, transparent 60%);
  color: var(--text);
  min-height: 100vh;
}

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }

/* ── Topbar ─────────────────────────────────────────────────── */
.topbar {
  position: sticky; top: 0; z-index: 100;
  height: 60px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2rem;
  background: rgba(7,8,15,0.9);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(24px);
}
.topbar-left, .topbar-right { display: flex; align-items: center; gap: 1.5rem; }
.brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
.brand-icon { font-size: 1.5rem; filter: drop-shadow(0 0 10px rgba(0,229,255,0.4)); }
.brand-name {
  font-size: 1.1rem; font-weight: 800; letter-spacing: -0.3px;
  background: linear-gradient(135deg, var(--cyan), var(--blue));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.brand-sub { font-size: 0.65rem; color: var(--muted); text-transform: uppercase; letter-spacing: 1.5px; }
.top-nav { display: flex; gap: 0.25rem; }
.nav-link {
  padding: 0.4rem 0.9rem; border-radius: var(--radius-sm);
  color: var(--muted2); font-size: 0.875rem; font-weight: 500;
  text-decoration: none; transition: var(--t);
}
.nav-link:hover { color: var(--text); background: rgba(255,255,255,0.05); }
.nav-link.active { color: var(--cyan); background: var(--cyan-dim); }
.live-badge {
  display: flex; align-items: center; gap: 0.4rem;
  background: var(--green-dim); border: 1px solid rgba(0,230,118,0.2);
  color: var(--green); padding: 0.3rem 0.85rem;
  border-radius: 99px; font-size: 0.75rem; font-weight: 500;
}
.live-dot {
  width: 6px; height: 6px; background: var(--green);
  border-radius: 50%; box-shadow: 0 0 6px var(--green);
  animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }

.main-content { min-height: calc(100vh - 60px); }

/* ── Utility ────────────────────────────────────────────────── */
.pill {
  display: inline-flex; align-items: center;
  padding: 0.2rem 0.6rem; border-radius: 99px;
  font-size: 0.7rem; font-weight: 600; letter-spacing: 0.3px;
}
.pill-active   { background: var(--green-dim);  color: var(--green);  border: 1px solid rgba(0,230,118,0.2); }
.pill-inactive { background: var(--red-dim);    color: var(--red);    border: 1px solid rgba(248,113,113,0.2); }
.pill-pending  { background: var(--orange-dim); color: var(--orange); border: 1px solid rgba(251,146,60,0.2); }
.pill-other    { background: var(--blue-dim);   color: var(--blue);   border: 1px solid rgba(96,165,250,0.2); }

.mono { font-family: 'JetBrains Mono', monospace; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-up { animation: fadeUp 0.4s ease both; }

@keyframes spin { to { transform: rotate(360deg); } }
.spinner {
  display: inline-block; width: 18px; height: 18px;
  border: 2px solid rgba(255,255,255,0.1); border-top-color: var(--cyan);
  border-radius: 50%; animation: spin 0.8s linear infinite;
}

/* ── Dashboard Page ─────────────────────────────────────────── */
.dashboard-page { padding: 2rem; display: flex; flex-direction: column; gap: 2rem; }
.page-header { display: flex; flex-direction: column; gap: 0.25rem; }
.page-title { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.5px; }
.page-subtitle { color: var(--muted2); font-size: 0.9rem; }

.stats-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 1rem;
}
.stat-card {
  background: var(--glass); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 1.25rem 1.5rem;
  display: flex; align-items: center; gap: 1rem;
  transition: var(--t); backdrop-filter: blur(12px);
}
.stat-card:hover { border-color: var(--border2); transform: translateY(-3px); box-shadow: var(--shadow); }
.stat-icon {
  width: 48px; height: 48px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0;
}
.si-blue   { background: var(--blue-dim); }
.si-green  { background: var(--green-dim); }
.si-cyan   { background: var(--cyan-dim); }
.si-purple { background: var(--purple-dim); }
.si-orange { background: var(--orange-dim); }

.stat-value {
  font-size: 1.6rem; font-weight: 800; line-height: 1;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(135deg, #fff, var(--muted2));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.stat-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.8px; margin-top: 4px; }

.dashboard-grid { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; }
.card {
  background: var(--glass); border: 1px solid var(--border);
  border-radius: var(--radius); backdrop-filter: blur(12px);
}
.card-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.card-title { font-size: 0.9rem; font-weight: 700; }
.card-body { padding: 1.25rem 1.5rem; }

.recent-lead-row {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.75rem 0; border-bottom: 1px solid var(--border);
  transition: var(--t); cursor: pointer; text-decoration: none; color: inherit;
}
.recent-lead-row:last-child { border-bottom: none; }
.recent-lead-row:hover { color: var(--cyan); }
.rl-usdot { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--cyan); min-width: 80px; }
.rl-name { font-size: 0.875rem; font-weight: 500; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rl-date { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }

.quick-actions { display: flex; flex-direction: column; gap: 0.75rem; }
.qa-btn {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 1rem 1.25rem; border-radius: var(--radius-sm);
  text-decoration: none; font-weight: 600; font-size: 0.875rem;
  transition: var(--t); border: 1px solid;
}
.qa-btn:hover { transform: translateX(4px); }
.qa-blue   { background: var(--blue-dim);   color: var(--blue);   border-color: rgba(96,165,250,0.2); }
.qa-green  { background: var(--green-dim);  color: var(--green);  border-color: rgba(0,230,118,0.2); }
.qa-purple { background: var(--purple-dim); color: var(--purple); border-color: rgba(192,132,252,0.2); }

/* ── CRM PLATFORM & ADVANCED FILTERING SYSTEM (Attio / Clay / Linear) ── */

.leads-page-container {
  padding: 1.5rem 2rem;
  display: flex; flex-direction: column; gap: 1.25rem;
}

/* Premium Top Toolbar */
.crm-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg2); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 0.75rem 1.25rem; gap: 1rem;
  backdrop-filter: blur(16px); flex-wrap: wrap;
}
.crm-tb-left, .crm-tb-right { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }

.crm-search-box {
  position: relative; display: flex; align-items: center;
  width: 320px; max-width: 100%;
}
.crm-search-icon { position: absolute; left: 12px; font-size: 0.85rem; color: var(--muted); }
.crm-search-input {
  width: 100%; padding: 0.55rem 0.8rem 0.55rem 2.2rem;
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius-sm); color: var(--text);
  font-family: inherit; font-size: 0.85rem; transition: var(--t);
}
.crm-search-input:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(0,229,255,0.1); }

.crm-tb-btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.55rem 1rem; background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius-sm); color: var(--text); font-size: 0.85rem; font-weight: 600;
  cursor: pointer; transition: var(--t);
}
.crm-tb-btn:hover { border-color: var(--border2); background: rgba(255,255,255,0.06); }
.crm-tb-btn.active { border-color: var(--cyan); background: var(--cyan-dim); color: var(--cyan); }
.crm-badge {
  background: var(--cyan); color: #07080f; font-size: 0.7rem; font-weight: 800;
  padding: 0.1rem 0.45rem; border-radius: 99px;
}

.crm-tb-btn-icon {
  padding: 0.55rem 0.85rem; background: transparent; border: 1px solid var(--border);
  border-radius: var(--radius-sm); color: var(--muted2); font-size: 0.82rem; font-weight: 500;
  cursor: pointer; transition: var(--t);
}
.crm-tb-btn-icon:hover { color: var(--text); border-color: var(--border2); background: rgba(255,255,255,0.03); }

.crm-tb-btn-export {
  padding: 0.55rem 1.2rem; background: linear-gradient(135deg, var(--cyan), var(--blue));
  border: none; border-radius: var(--radius-sm); color: #07080f;
  font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: var(--t);
}
.crm-tb-btn-export:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,229,255,0.3); }

/* Active Chips Bar */
.filter-chips-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(18,21,42,0.4); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 0.6rem 1rem; gap: 1rem; flex-wrap: wrap;
}
.fc-left { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.fc-matching-tag { font-size: 0.82rem; color: var(--muted2); }
.fc-matching-tag strong { color: var(--cyan); }
.fc-chips-list { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.chip-item {
  display: inline-flex; align-items: center; gap: 0.4rem;
  background: var(--cyan-dim); border: 1px solid rgba(0,229,255,0.25);
  color: var(--cyan); font-size: 0.78rem; font-weight: 600;
  padding: 0.25rem 0.65rem; border-radius: 99px;
}
.chip-remove {
  background: none; border: none; color: var(--cyan); font-size: 0.75rem;
  cursor: pointer; opacity: 0.7; transition: var(--t);
}
.chip-remove:hover { opacity: 1; transform: scale(1.2); }
.fc-clear-all {
  background: none; border: none; color: var(--red); font-size: 0.78rem;
  font-weight: 600; cursor: pointer; transition: var(--t);
}
.fc-clear-all:hover { text-decoration: underline; }

/* Bulk Selection Banner */
.bulk-banner {
  display: flex; align-items: center; gap: 1rem;
  background: var(--blue-dim); border: 1px solid rgba(96,165,250,0.3);
  color: var(--blue); padding: 0.6rem 1.25rem; border-radius: var(--radius-sm);
  font-size: 0.85rem; flex-wrap: wrap;
}
.bulk-btn-link {
  background: none; border: none; color: #fff; font-weight: 700; text-decoration: underline;
  cursor: pointer; font-size: 0.85rem;
}
.bulk-btn-clear {
  background: none; border: none; color: var(--muted2); font-size: 0.78rem;
  cursor: pointer; margin-left: auto; text-decoration: underline;
}

/* CRM Table */
.table-wrap-card {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: auto;
}
.crm-table { width: 100%; border-collapse: collapse; min-width: 900px; }
.crm-table th {
  padding: 0.85rem 1rem; background: var(--bg3); border-bottom: 1px solid var(--border);
  font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;
  color: var(--muted); text-align: left; position: sticky; top: 0; z-index: 5;
}
.crm-table th.sortable { cursor: pointer; user-select: none; }
.crm-table th.sortable:hover { color: var(--cyan); }
.crm-table td {
  padding: 0.8rem 1rem; border-bottom: 1px solid var(--border);
  font-size: 0.85rem; vertical-align: middle;
}
.crm-table tr { transition: var(--t); }
.crm-table tr:hover { background: rgba(255,255,255,0.02); }
.crm-table tr.row-selected { background: rgba(0,229,255,0.05); }

.crm-pagination {
  display: flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 1rem 0;
}
.pg-info { font-size: 0.82rem; color: var(--muted2); margin: 0 0.5rem; }

/* Filter Side Drawer */
.filter-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px); z-index: 300;
}
.filter-panel-drawer {
  position: fixed; top: 0; right: 0; width: 440px; max-width: 95vw;
  height: 100vh; background: var(--bg2); border-left: 1px solid var(--border2);
  z-index: 301; display: flex; flex-direction: column;
  box-shadow: -20px 0 60px rgba(0,0,0,0.6);
}
.fp-head {
  padding: 1.25rem 1.5rem; background: var(--bg3); border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.fp-head-title { font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 0.6rem; }
.fp-count-badge { font-size: 0.72rem; color: var(--cyan); background: var(--cyan-dim); padding: 0.2rem 0.5rem; border-radius: 99px; }
.fp-close { background: none; border: none; color: var(--muted); font-size: 1rem; cursor: pointer; }
.fp-close:hover { color: var(--text); }

.fp-body { flex: 1; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
.fp-section { background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
.fp-sec-header {
  padding: 0.8rem 1rem; font-size: 0.85rem; font-weight: 700;
  display: flex; justify-content: space-between; align-items: center;
  cursor: pointer; user-select: none; transition: var(--t);
}
.fp-sec-header:hover { background: rgba(255,255,255,0.03); color: var(--cyan); }
.fp-sec-content { padding: 1rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.8rem; }

.fp-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); margin-bottom: 0.3rem; display: block; }
.fp-input, .fp-select {
  width: 100%; padding: 0.5rem 0.7rem; background: var(--bg);
  border: 1px solid var(--border); border-radius: 7px; color: var(--text);
  font-family: inherit; font-size: 0.82rem; transition: var(--t);
}
.fp-input:focus, .fp-select:focus { outline: none; border-color: var(--cyan); }

.fp-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
.fp-checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }

.fp-chip-check {
  display: flex; align-items: center; gap: 0.4rem;
  padding: 0.4rem 0.6rem; background: var(--bg); border: 1px solid var(--border);
  border-radius: 7px; font-size: 0.78rem; color: var(--muted2); cursor: pointer; transition: var(--t);
}
.fp-chip-check.selected { border-color: var(--cyan); background: var(--cyan-dim); color: var(--cyan); font-weight: 600; }

.fp-states-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; }
.fp-state-btn {
  padding: 0.3rem 0; background: var(--bg); border: 1px solid var(--border);
  border-radius: 5px; color: var(--muted2); font-size: 0.7rem; font-weight: 600;
  cursor: pointer; transition: var(--t); text-align: center;
}
.fp-state-btn:hover { border-color: var(--border2); color: var(--text); }
.fp-state-btn.active { background: var(--cyan); color: #07080f; border-color: var(--cyan); font-weight: 800; }

.fp-link-btn { background: none; border: none; color: var(--cyan); font-size: 0.75rem; cursor: pointer; text-decoration: underline; }
.fp-add-btn { background: var(--cyan-dim); border: 1px solid rgba(0,229,255,0.3); color: var(--cyan); padding: 0.2rem 0.5rem; border-radius: 5px; font-size: 0.75rem; font-weight: 600; cursor: pointer; }

.fp-rule-row { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.4rem; }
.fp-rule-and { font-size: 0.68rem; font-weight: 800; color: var(--orange); }
.fp-select-sm { padding: 0.3rem 0.4rem; background: var(--bg); border: 1px solid var(--border); border-radius: 5px; color: var(--text); font-size: 0.75rem; }
.fp-input-sm { flex: 1; padding: 0.3rem 0.4rem; background: var(--bg); border: 1px solid var(--border); border-radius: 5px; color: var(--text); font-size: 0.75rem; }
.fp-rule-del { background: none; border: none; color: var(--red); font-size: 0.8rem; cursor: pointer; }

.fp-foot { padding: 1rem 1.25rem; background: var(--bg3); border-top: 1px solid var(--border); display: flex; gap: 0.75rem; }
.fp-btn-reset { padding: 0.6rem 1rem; background: transparent; border: 1px solid var(--border); color: var(--muted2); border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
.fp-btn-apply { flex: 1; padding: 0.6rem 1rem; background: linear-gradient(135deg, var(--cyan), var(--blue)); border: none; color: #07080f; border-radius: 8px; font-size: 0.85rem; font-weight: 700; cursor: pointer; }

/* Modals */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.7);
  backdrop-filter: blur(6px); z-index: 400; display: flex; align-items: center; justify-content: center; padding: 1rem;
}
.modal-card {
  width: 100%; background: var(--bg2); border: 1px solid var(--border2);
  border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; display: flex; flex-direction: column;
}
.modal-header {
  padding: 1.25rem 1.5rem; background: var(--bg3); border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: flex-start;
}
.modal-title { font-size: 1.1rem; font-weight: 800; }
.modal-sub { font-size: 0.8rem; color: var(--muted2); margin-top: 2px; }
.modal-sub strong { color: var(--cyan); }
.modal-close { background: none; border: none; color: var(--muted); font-size: 1rem; cursor: pointer; }
.modal-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; max-height: 75vh; overflow-y: auto; }
.modal-footer { padding: 1rem 1.5rem; background: var(--bg3); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 0.75rem; }

.modal-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--muted); margin-bottom: 0.5rem; display: block; }
.btn-primary { padding: 0.5rem 1rem; background: var(--cyan); color: #07080f; border: none; border-radius: 7px; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
.btn-primary-lg { padding: 0.7rem 1.5rem; background: linear-gradient(135deg, var(--cyan), var(--blue)); color: #07080f; border: none; border-radius: 8px; font-weight: 800; font-size: 0.9rem; cursor: pointer; }
.btn-secondary { padding: 0.6rem 1rem; background: transparent; border: 1px solid var(--border); color: var(--muted2); border-radius: 8px; font-size: 0.85rem; cursor: pointer; }

/* Export Modal Options */
.ex-radio-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
.ex-card {
  padding: 0.75rem; background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius-sm); display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer; transition: var(--t);
}
.ex-card.active { border-color: var(--cyan); background: var(--cyan-dim); }
.ex-card-title { font-size: 0.85rem; font-weight: 700; }
.ex-card-desc { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }

.ex-scope-list { display: flex; flex-direction: column; gap: 0.5rem; }
.ex-scope-item {
  padding: 0.75rem 1rem; background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius-sm); display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; transition: var(--t);
}
.ex-scope-item.active { border-color: var(--cyan); background: var(--cyan-dim); }
.ex-subtext { font-size: 0.75rem; color: var(--muted2); display: block; margin-top: 2px; }

.ex-cols-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; max-height: 180px; overflow-y: auto; }
.ex-col-item {
  display: flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.6rem;
  background: var(--bg3); border: 1px solid var(--border); border-radius: 6px; font-size: 0.78rem; color: var(--muted2); cursor: pointer;
}
.ex-col-item.checked { border-color: var(--border2); color: var(--text); }

/* Saved Views & History */
.sv-list, .eh-list { display: flex; flex-direction: column; gap: 0.6rem; }
.sv-item {
  padding: 0.75rem 1rem; background: var(--bg3); border: 1px solid var(--border);
  border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
}
.sv-item-name { font-size: 0.88rem; font-weight: 700; color: var(--text); }
.sv-item-desc { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
.sv-item-actions { display: flex; gap: 0.4rem; align-items: center; }
.btn-apply-sm { padding: 0.3rem 0.7rem; background: var(--cyan-dim); border: 1px solid rgba(0,229,255,0.3); color: var(--cyan); border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer; }
.btn-del-sm { background: none; border: none; color: var(--red); font-size: 0.8rem; cursor: pointer; padding: 0 0.3rem; }

.eh-card { padding: 0.85rem 1rem; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 0.4rem; }
.eh-head { display: flex; justify-content: space-between; align-items: center; }
.eh-file { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--cyan); font-weight: 600; }
.eh-badge { background: var(--blue-dim); color: var(--blue); font-size: 0.68rem; font-weight: 800; padding: 0.1rem 0.4rem; border-radius: 4px; }
.eh-meta { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); }
.eh-summary { font-size: 0.75rem; color: var(--muted2); border-top: 1px solid var(--border); padding-top: 0.3rem; margin-top: 0.2rem; }

.cv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
.cv-item {
  display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem;
  background: var(--bg3); border: 1px solid var(--border); border-radius: 7px;
  font-size: 0.82rem; color: var(--muted2); cursor: pointer; transition: var(--t);
}
.cv-item.active { border-color: var(--cyan); color: var(--text); background: var(--cyan-dim); }

@media (max-width: 768px) {
  .crm-toolbar { flex-direction: column; align-items: stretch; }
  .crm-search-box { width: 100%; }
  .ex-radio-cards { grid-template-columns: 1fr; }
  .ex-cols-grid { grid-template-columns: 1fr; }
  .fp-states-grid { grid-template-columns: repeat(5, 1fr); }
}
